rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para desarrollo - CAMBIAR EN PRODUCCIÓN
    match /{document=**} {
      // Permitir lectura y escritura sin autenticación (TEMPORAL)
      allow read, write: if true;
    }
    
    // REGLAS PARA PRODUCCIÓN (descomentar y agregar Firebase Auth):
    /*
    match /registros/{registroId} {
      // Solo usuarios autenticados pueden leer y escribir
      allow read, write: if request.auth != null;
      
      // Validaciones adicionales
      allow create: if request.auth != null 
        && request.resource.data.keys().hasAll(['tipo', 'categoria', 'monto', 'fecha'])
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.monto is number
        && request.resource.data.fecha is string;
      
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['monto', 'fecha', 'descripcion']);
      
      allow delete: if request.auth != null;
    }
    
    match /categorias/{categoriaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['nombre', 'tipo'])
        && request.resource.data.tipo in ['ingreso', 'egreso'];
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    */
  }
}
